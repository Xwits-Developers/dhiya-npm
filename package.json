{
  "name": "dhiya-npm",
  "version": "2.0.0",
  "description": "Client-side RAG chatbot for the browser: WebGPU/WASM embeddings, IndexedDB vector store, local LLM answers (Chrome built-in AI or Transformers.js), streaming, and a drop-in <dhiya-chat> widget. No servers, no API keys.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js",
      "default": "./dist/widget/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/widget/index.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npm run build && node scripts/smoke-test.mjs",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "example": "npm run build && cd examples/vite-demo && npm install && npx vite",
    "prepublishOnly": "npm run build && node scripts/smoke-test.mjs"
  },
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "client-side rag",
    "browser rag",
    "offline rag",
    "vector search",
    "webgpu embeddings",
    "wasm embeddings",
    "local llm",
    "privacy rag",
    "in-browser ai",
    "rag framework",
    "chatbot widget",
    "chrome built-in ai",
    "transformers.js"
  ],
  "author": "Deep Parmar <deep.parmar@sunbots.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xwits-Developers/dhiya-npm.git"
  },
  "bugs": {
    "url": "https://github.com/Xwits-Developers/dhiya-npm/issues"
  },
  "homepage": "https://github.com/Xwits-Developers/dhiya-npm#readme",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.16.0",
    "fake-indexeddb": "^6.2.3",
    "happy-dom": "^20.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
